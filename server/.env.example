# verbo-backend env — copy to .env.local (gitignored via the *.local rule
# in the repo root .gitignore). Do NOT commit real values.

# Required. Your OpenAI API key — create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Required. Comma-separated list of origins allowed to call /api/* routes
# (spaces around commas are trimmed). Requests from other origins get 403.
# /health is exempt. For production, replace with your deployed client origin(s),
# e.g. https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Port the server listens on (default: 8787).
# PORT=8787
