# Verbo client env — copy to .env.local (gitignored via the *.local rule).
#
# VITE_PROXY_URL points to the verbo-backend proxy (see server/README.md).
# The default below matches the local dev server (`npm run server`).
# For production builds, set it to your deployed backend URL,
# e.g. https://your-app.fly.dev

VITE_PROXY_URL=http://localhost:8787
